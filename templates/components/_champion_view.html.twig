{# Grid for one champion, 2 coloumn 1/12 champion square, 11/12 cooldowns #}
<div class="grid grid-cols-12 my-2 w-full md:text-base text-sm text-center text-gray-700 dark:text-gray-400">
    {% if champion|default %}
    {# Champion image #}
    <div class="col-span-1 items-center justify-center m-auto">
        <img class="h-14 min-w-14" src="{{ champion.image }}" alt="Image of the champion.">
    </div>
    {% if spells|default %}
    <div class="col-span-11 grid grid-cols-12">
        {% for spell in spells  %}
        <div class="col-span-1">
            <img class="h-8 mx-auto"  src="{{ spell.image }}" alt="Image of the ability.">
        </div>

            {% if spell.cooldowns|length > 6 %}
            <div class="grid grid-cols-7 col-span-5">
            {% elseif spell.cooldowns|length > 5 %}
            <div class="grid grid-cols-6 col-span-5">
            {% else %}
            <div class="grid grid-cols-5 col-span-5">
            {% endif %}

            {% for cooldown in spell.cooldowns %}
                <div class="col-span-1 w-8 md:text-base text-sm text-center justify-center p-0.5 m-auto text-gray-700 dark:text-gray-400" >
                    {% if spell.affectedByCdr %}
                        {# Reduced Cooldown = Base Cooldown x 100 / (100 + Haste) #}
                        {{ (cooldown * 100 / (100 + haste)) | round(1) }}
                    {% else %}
                        {{ cooldown }}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        {% endfor %}
    </div>
    {% endif %}
    {% endif %}
</div>
