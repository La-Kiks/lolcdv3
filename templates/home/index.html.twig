    {# Champion view #}
    <div class="p-1 md:ml-64 overflow-x-auto ">
        <div class="grid grid-cols-12 my-2 w-full md:text-base text-sm text-center text-gray-700 dark:text-gray-400">
        {% if championOne|default %}
            <div class="col-span-1 items-center justify-center m-auto">
                <img class="h-14 min-w-14" src="{{ championOne.image }}" alt="Image of the champion.">
            </div>
            {% if spellsOne|default %}
                {# Col 12 spell image + rank 5 #}
                <div class="grid grid-cols-12 col-span-11">
                    {% set colCount = 0 %}
                    {% for spell in spellsOne  %}
                        {% if colCount + spell.cooldowns|length > 11 %}
                            {% set span = 12 - colCount %}
                            {% if span != 0 %}
                                <div class="col-span-{{ span }}"></div>
                            {% endif %}
                            {% set colCount = 0 %}
                        {% endif %}
                        <div class="col-span-1">
                            <img class="h-8 mx-auto"  src="{{ spell.image }}" alt="Image of the ability.">
                        </div>
                        {% set colCount = colCount + 1 %}
                        {% for cooldown in spell.cooldowns %}
                            {% set colCount = colCount + 1 %}
                            <div class="col-span-1 md:text-base text-sm text-center justify-center p-0.5 m-auto text-gray-700 dark:text-gray-400" >
                                {% if spell.affectedByCdr %}
                                    {# Reduced Cooldown = Base Cooldown x 100 / (100 + Haste) #}
                                    {{ (cooldown * 100 / (100 + hasteOne)) | round(1) }}
                                {% else %}
                                    {{ cooldown }}
                                {% endif %}
                            </div>
                        {% endfor %}

                {% endfor %}
                </div>
            {% endif %}
        {% endif %}
        </div>

